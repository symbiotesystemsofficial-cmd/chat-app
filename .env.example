# Backend config — Supabase YA Firebase me se ek ke values bharein.
# Supabase mile to wahi use hoga, warna Firebase, warna demo mode.
# In values ko Vercel > Settings > Environment Variables me lagayein.

# --- Supabase (preferred) ---
# Supabase dashboard → Project Settings → API se milega
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Firebase (alternative) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
